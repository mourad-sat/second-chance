generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BeneficiaryStatus {
  PRE_REGISTERED
  UNDER_REVIEW
  WAITLISTED
  ACCEPTED
  REJECTED
  ENROLLED
  WITHDRAWN
  COMPLETED
}

model Beneficiary {
  id                 String            @id @default(cuid())
  firstName          String
  lastName           String
  birthDate          DateTime?
  identityNumber     String?           @unique
  phone              String?
  guardianPhone      String?
  address            String?
  lastEducationLevel String?
  status             BeneficiaryStatus @default(PRE_REGISTERED)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}
