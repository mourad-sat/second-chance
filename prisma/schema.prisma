generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BeneficiaryStatus {
  PRE_REGISTERED
  UNDER_REVIEW
  WAITLISTED
  ACCEPTED
  REJECTED
  ENROLLED
  WITHDRAWN
  COMPLETED
}

enum AdmissionDecision {
  PENDING
  ACCEPTED
  WAITLISTED
  REJECTED
  NEEDS_REASSESSMENT
}

model Beneficiary {
  id                 String            @id @default(cuid())
  firstName          String
  lastName           String
  birthDate          DateTime?
  identityNumber     String?           @unique
  phone              String?
  guardianPhone      String?
  address            String?
  lastEducationLevel String?
  status             BeneficiaryStatus @default(PRE_REGISTERED)

  familySituation       String?
  guardianName          String?
  guardianRelationship  String?
  householdSize         Int?
  familyIncomeSituation String?
  housingSituation      String?
  socialCoverage        String?

  lastSchoolName       String?
  dropoutYear          Int?
  dropoutReasons       String?
  learningDifficulties String?
  specialNeeds         String?

  diagnosticSummary String?
  strengths         String?
  priorityNeeds     String?
  supportPlan       String?
  careerGoal        String?
  followUpNotes     String?

  admissionAssessment AdmissionAssessment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdmissionAssessment {
  id            String      @id @default(cuid())
  beneficiaryId String      @unique
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  interviewDate       DateTime?
  interviewerName     String?
  interviewSummary    String?
  motivationLevel     Int?
  attendanceReadiness Int?

  arabicScore          Float?
  frenchScore          Float?
  mathematicsScore     Float?
  cognitiveScore       Float?
  psychologicalSummary String?

  creativeDigitalInterest Float?
  socialServicesInterest  Float?
  technicalInterest       Float?
  greenEconomyInterest    Float?
  culturalAnimationInterest Float?
  vocationalInterestNotes String?

  proposedTrack     String?
  proposedSpecialty String?
  orientationReason String?
  committeeNotes    String?
  decision          AdmissionDecision @default(PENDING)
  decisionDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
