generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BeneficiaryStatus {
  PRE_REGISTERED
  UNDER_REVIEW
  WAITLISTED
  ACCEPTED
  REJECTED
  ENROLLED
  WITHDRAWN
  COMPLETED
}

enum AdmissionDecision {
  PENDING
  ACCEPTED
  WAITLISTED
  REJECTED
  NEEDS_REASSESSMENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssessmentType {
  DIAGNOSTIC
  FORMATIVE
  SUMMATIVE
  PROJECT
  PRACTICAL
}

enum SocialFollowUpType {
  INDIVIDUAL_INTERVIEW
  FAMILY_VISIT
  PHONE_CALL
  MEDIATION
  REFERRAL
  MATERIAL_SUPPORT
  PSYCHOLOGICAL_SUPPORT
  OTHER
}

enum FollowUpPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FollowUpStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SupportPlanStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SUSPENDED
}

enum SupportPlanPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActivityCategory {
  REGISTRATION
  DIAGNOSIS
  ADMISSION
  ATTENDANCE
  ASSESSMENT
  SUPPORT
  SOCIAL
  TRAINING
  INTERNSHIP
  INTEGRATION
  DOCUMENT
  NOTE
}

enum SkillLevel {
  NOT_ASSESSED
  BEGINNER
  DEVELOPING
  COMPETENT
  ADVANCED
}

enum ProjectStatus {
  IDEA
  PLANNING
  IN_PROGRESS
  COMPLETED
  SUSPENDED
}

enum InternshipStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  ASSOCIATION_MANAGER
  PROGRAM_COORDINATOR
  CENTER_MANAGER
  FACILITATOR
  SOCIAL_WORKER
  VOCATIONAL_TRAINER
  INTEGRATION_OFFICER
  VIEWER
}

enum DocumentCategory {
  IDENTITY
  ENROLLMENT
  EDUCATION
  SOCIAL
  TRAINING
  INTERNSHIP
  INTEGRATION
  OTHER
}

model Beneficiary {
  id                 String            @id @default(cuid())
  firstName          String
  lastName           String
  birthDate          DateTime?
  identityNumber     String?           @unique
  phone              String?
  guardianPhone      String?
  address            String?
  lastEducationLevel String?
  status             BeneficiaryStatus @default(PRE_REGISTERED)
  familySituation       String?
  guardianName          String?
  guardianRelationship  String?
  householdSize         Int?
  familyIncomeSituation String?
  housingSituation      String?
  socialCoverage        String?
  lastSchoolName       String?
  dropoutYear          Int?
  dropoutReasons       String?
  learningDifficulties String?
  specialNeeds         String?
  diagnosticSummary String?
  strengths         String?
  priorityNeeds     String?
  supportPlan       String?
  careerGoal        String?
  followUpNotes     String?
  admissionAssessment  AdmissionAssessment?
  enrollments          GroupEnrollment[]
  attendanceRecords    AttendanceRecord[]
  academicResults      AcademicResult[]
  academicSupportPlans AcademicSupportPlan[]
  socialFollowUps      SocialFollowUp[]
  activityLogs         ActivityLog[]
  skillEvaluations     SkillEvaluation[]
  vocationalProjects   VocationalProject[]
  internships          Internship[]
  documents            Document[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdmissionAssessment {
  id String @id @default(cuid())
  beneficiaryId String @unique
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  interviewDate DateTime?
  interviewerName String?
  interviewSummary String?
  motivationLevel Int?
  attendanceReadiness Int?
  arabicScore Float?
  frenchScore Float?
  mathematicsScore Float?
  cognitiveScore Float?
  psychologicalSummary String?
  creativeDigitalInterest Float?
  socialServicesInterest Float?
  technicalInterest Float?
  greenEconomyInterest Float?
  culturalAnimationInterest Float?
  vocationalInterestNotes String?
  proposedTrack String?
  proposedSpecialty String?
  orientationReason String?
  committeeNotes String?
  decision AdmissionDecision @default(PENDING)
  decisionDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearningGroup {
  id String @id @default(cuid())
  name String
  academicYear String
  track String?
  specialty String?
  room String?
  facilitator String?
  isActive Boolean @default(true)
  enrollments GroupEnrollment[]
  attendance AttendanceRecord[]
  assessments AcademicAssessment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([name, academicYear])
}

model GroupEnrollment {
  id String @id @default(cuid())
  beneficiaryId String
  groupId String
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  group LearningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())
  leftAt DateTime?
  @@unique([beneficiaryId, groupId])
}

model AttendanceRecord {
  id String @id @default(cuid())
  beneficiaryId String
  groupId String
  date DateTime
  status AttendanceStatus
  arrivalTime String?
  excuse String?
  notes String?
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  group LearningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([beneficiaryId, groupId, date])
  @@index([date, status])
}

model AcademicAssessment {
  id String @id @default(cuid())
  groupId String
  group LearningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title String
  subject String
  type AssessmentType
  assessmentDate DateTime
  maxScore Float @default(20)
  results AcademicResult[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicResult {
  id String @id @default(cuid())
  assessmentId String
  beneficiaryId String
  score Float?
  competencyLevel String?
  notes String?
  assessment AcademicAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([assessmentId, beneficiaryId])
}

model AcademicSupportPlan {
  id String @id @default(cuid())
  beneficiaryId String
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  difficulty String
  objective String
  intervention String
  responsibleName String?
  priority SupportPlanPriority @default(NORMAL)
  status SupportPlanStatus @default(PLANNED)
  startDate DateTime @default(now())
  reviewDate DateTime?
  progressPercent Int @default(0)
  successIndicator String?
  observations String?
  outcome String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, priority])
  @@index([reviewDate])
}

model SocialFollowUp {
  id String @id @default(cuid())
  beneficiaryId String
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  type SocialFollowUpType
  priority FollowUpPriority @default(NORMAL)
  status FollowUpStatus @default(OPEN)
  eventDate DateTime
  responsibleName String?
  subject String
  details String?
  actionsTaken String?
  partnerName String?
  referralReason String?
  nextAction String?
  nextFollowUpDate DateTime?
  outcome String?
  confidentialityNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, priority])
  @@index([eventDate])
}

model ActivityLog {
  id String @id @default(cuid())
  beneficiaryId String
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  category ActivityCategory
  title String
  description String?
  actorName String?
  referenceType String?
  referenceId String?
  referenceHref String?
  eventDate DateTime @default(now())
  metadata Json?
  createdAt DateTime @default(now())
  @@index([beneficiaryId, eventDate])
  @@index([category, eventDate])
}

model VocationalProgram {
  id String @id @default(cuid())
  track String
  specialty String
  moduleName String
  description String?
  totalHours Int?
  isActive Boolean @default(true)
  competencies VocationalCompetency[]
  workshops WorkshopSession[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([track, specialty, moduleName])
}

model VocationalCompetency {
  id String @id @default(cuid())
  programId String
  code String?
  title String
  description String?
  targetLevel SkillLevel @default(COMPETENT)
  program VocationalProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  evaluations SkillEvaluation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([programId, title])
}

model WorkshopSession {
  id String @id @default(cuid())
  programId String
  sessionDate DateTime
  title String
  trainerName String?
  durationHours Float?
  location String?
  activities String?
  materials String?
  observations String?
  program VocationalProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkillEvaluation {
  id String @id @default(cuid())
  beneficiaryId String
  competencyId String
  evaluationDate DateTime
  level SkillLevel @default(NOT_ASSESSED)
  score Float?
  evaluatorName String?
  evidence String?
  notes String?
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  competency VocationalCompetency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([beneficiaryId, competencyId, evaluationDate])
}

model VocationalProject {
  id String @id @default(cuid())
  beneficiaryId String
  title String
  description String?
  status ProjectStatus @default(IDEA)
  mentorName String?
  startDate DateTime?
  targetDate DateTime?
  completionDate DateTime?
  progressPercent Int @default(0)
  skillsApplied String?
  deliverables String?
  evaluationNotes String?
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Internship {
  id String @id @default(cuid())
  beneficiaryId String
  organizationName String
  field String?
  supervisorName String?
  supervisorPhone String?
  startDate DateTime
  endDate DateTime?
  status InternshipStatus @default(PLANNED)
  objectives String?
  tasks String?
  attendanceNotes String?
  supervisorEvaluation String?
  finalResult String?
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id String @id @default(cuid())
  beneficiaryId String
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  title String
  category DocumentCategory @default(OTHER)
  fileName String
  mimeType String
  sizeBytes Int
  data Bytes
  notes String?
  uploadedById String?
  uploadedByName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([beneficiaryId, category])
  @@index([createdAt])
}

model User {
  id String @id @default(cuid())
  fullName String
  email String @unique
  passwordHash String
  role UserRole @default(VIEWER)
  centerName String?
  isActive Boolean @default(true)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
  @@index([role, isActive])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action String
  entityType String?
  entityId String?
  description String?
  ipAddress String?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([action, createdAt])
}
